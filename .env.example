# Docker Compose variables. Copy to .env before `docker compose up --build`.

# Keitaro Admin API. The default points at the bundled deterministic mock.
# For a real tracker set these to your instance
KEITARO_BASE_URL=http://keitaro-mock:8000/admin_api/v1
KEITARO_API_KEY=dev-api-key
KEITARO_TIMEOUT_SECONDS=15

# Optional: pin catalog entities used by the campaign creator.
DEFAULT_DOMAIN_ID=
DEFAULT_CAMPAIGN_GROUP_ID=
DEFAULT_TRAFFIC_SOURCE_ID=
GEO_REDIRECT_URL=https://google.com

# Host ports
FRONTEND_PORT=8080
BACKEND_PORT=8000
MOCK_KEITARO_PORT=8001
POSTGRES_PORT=5433
