# Application
APP_NAME=Keitaro Wrapper
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://keitaro:keitaro@localhost:5433/keitaro

# Keitaro Admin API
KEITARO_BASE_URL=http://localhost:8001/admin_api/v1
KEITARO_API_KEY=dev-api-key
KEITARO_TIMEOUT_SECONDS=15

# Optional defaults for the campaign creator. When empty, the first active
# domain / campaign group / traffic source from Keitaro is used.
DEFAULT_DOMAIN_ID=
DEFAULT_CAMPAIGN_GROUP_ID=
DEFAULT_TRAFFIC_SOURCE_ID=

# Where the geo flow sends visitors
GEO_REDIRECT_URL=https://google.com

# Comma-separated list
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
